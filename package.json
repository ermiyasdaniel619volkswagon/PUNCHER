{
  "name": "puncher",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "network:connect": "powershell -ExecutionPolicy Bypass -File scripts/connect-puncher-network.ps1",
    "diagnose": "powershell -ExecutionPolicy Bypass -File scripts/diagnose-puncher.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
